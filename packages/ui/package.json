{
  "name": "@richtillman/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/app.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src .storybook",
    "lint:fix": "oxlint src .storybook --fix",
    "format": "oxfmt src .storybook",
    "test": "vitest run --project=unit --config vitest.config.ts",
    "test:storybook": "vitest run --project=storybook --config vitest.config.ts",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook",
    "chromatic": "chromatic --storybook-build-dir=storybook-static"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/tanstack-react": "^10.5.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "chromatic": "^18.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
