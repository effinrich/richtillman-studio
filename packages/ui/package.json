{
  "name": "@richtillman/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/app.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src .storybook",
    "lint:fix": "oxlint src .storybook --fix",
    "format": "oxfmt src .storybook",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build --stats-json",
    "chromatic-build": "storybook build --stats-json",
    "chromatic": "chromatic --config-file ../../chromatic.config.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "chromatic": "^18.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
