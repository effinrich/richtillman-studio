{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "richtillman-studio",
  // The Worker entry. It wraps Start's handler so the HTML document can opt
  // out of Cloudflare's edge transforms, which is what stops the edge from
  // injecting the Bot Fight Mode script into every page.
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],

  // The local dev server's port. 8788 belongs to the ForgeKit Studio on this
  // machine, and its Figma plugin manifests allow only http://localhost:8788,
  // so that port cannot move. Cloudflare's default is 8787, which another dev
  // server holds, and wrangler then picks a port at random and only prints it.
  "dev": { "port": 8790 },

  // Workers Logs — same as portfolio-1. Secrets via `wrangler secret put`, never here.
  "observability": {
    "enabled": true,
    "invocation_logs": true
  },
  "traces": {
    "enabled": false
  },

  // Content storage. The contact form writes here through a server function,
  // so no database credential ever reaches the browser.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "richtillman-studio",
      "database_id": "a2bb23b2-21e7-40a7-91a9-3e1487096796",
      "migrations_dir": "d1"
    }
  ]
}
