# Supabase — set these in apps/web/.env.local (never commit real values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Chromatic — GitHub secret CHROMATIC_PROJECT_TOKEN. Do not commit the real token.
CHROMATIC_PROJECT_TOKEN=

# AI Gateway (optional, when you add AI later). Prefer OIDC via `vercel env pull`.
# AI_GATEWAY_API_KEY=
