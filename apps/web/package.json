{
  "name": "@richtillman/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src .storybook",
    "lint:fix": "oxlint src .storybook --fix",
    "format": "oxfmt src .storybook",
    "test": "vitest run --project=unit --config vitest.config.ts",
    "test:storybook": "vitest run --project=storybook --config vitest.config.ts",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook",
    "chromatic": "chromatic",
    "deploy": "vercel deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@richtillman/ui": "workspace:*",
    "@supabase/supabase-js": "^2.110.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.545.0",
    "nitro": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/tanstack-react": "^10.5.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "chromatic": "^18.0.1",
    "jsdom": "^28.1.0",
    "storybook": "^10.5.0",
    "typescript": "^6.0.2",
    "vercel": "^48.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
